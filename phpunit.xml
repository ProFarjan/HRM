<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheResultFile="tests/_output/.phpunit.result.cache"
         failOnWarning="true"
         failOnRisky="true"
         convertDeprecationsToExceptions="false">
    <testsuites>
        <!-- Guardrail tests run first; a failure there blocks everything else (CLAUDE.md "Testing"). -->
        <testsuite name="guardrails">
            <file>tests/Guardrail_static_checks_test.php</file>
            <file>tests/Guardrail_permission_coverage_test.php</file>
            <file>tests/Input_validator_test.php</file>
        </testsuite>
        <testsuite name="foundation-administration-organisation-time">
            <file>tests/Tx_test.php</file>
            <file>tests/Idempotency_test.php</file>
            <file>tests/Sequences_test.php</file>
            <file>tests/Helpers_test.php</file>
            <file>tests/Permission_scope_test.php</file>
            <file>tests/Auth_test.php</file>
            <file>tests/Auth_flow_test.php</file>
            <file>tests/Datatable_request_test.php</file>
            <file>tests/Users_test.php</file>
            <file>tests/Roles_test.php</file>
            <file>tests/Branches_test.php</file>
            <file>tests/Settings_test.php</file>
            <file>tests/Audit_test.php</file>
            <file>tests/Admin_flow_test.php</file>
            <file>tests/Organisation_units_test.php</file>
            <file>tests/Employees_test.php</file>
            <file>tests/Employee_pin_test.php</file>
            <file>tests/Salary_structure_test.php</file>
            <file>tests/Organisation_flow_test.php</file>
            <file>tests/Shift_calculator_test.php</file>
            <file>tests/Shifts_test.php</file>
            <file>tests/Rosters_test.php</file>
            <file>tests/Holidays_test.php</file>
            <file>tests/Time_flow_test.php</file>
            <file>tests/Migration_roundtrip_test.php</file>
        </testsuite>
    </testsuites>
</phpunit>

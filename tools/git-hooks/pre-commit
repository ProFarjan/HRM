#!/bin/sh
# Guardrail scan before every commit (CLAUDE.md G8). Enable once per clone:  git config core.hooksPath tools/git-hooks
cd "$(git rev-parse --show-toplevel)" || exit 1

for f in $(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' | grep -v '^tests/fixtures/'); do
    php -l "$f" >/dev/null || { echo "Syntax error in $f"; exit 1; }
done

php tests/static_checks.php || { echo "Commit refused: fix the violations above (php tests/static_checks.php)."; exit 1; }
